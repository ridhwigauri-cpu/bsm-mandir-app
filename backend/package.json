{
  "name": "bsm-mandir-backend",
  "version": "1.2.0",
  "description": "बाबा सिद्धनाथ मंदिर जीर्णोद्धार सेवा फाउंडेशन — API सर्वर (दान, पूजा, धर्मशाला, घोषणा, AI अलर्ट)",
  "type": "module",
  "main": "src/server.js",
  "lambda": "src/lambda.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build-check.js",
    "migrate:direct": "node src/scripts/migrate.js",
    "smoke": "node scripts/smoke.js",
    "test:function": "node scripts/test-function.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1179.0",
    "@aws-sdk/s3-request-presigner": "^3.1179.0",
    "@neon/config": "^1.14.8",
    "@neon/env": "^2.1.11",
    "@neon/functions": "^0.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "puppeteer-core": "^24.43.1",
    "serverless-http": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "pg-mem": "^3.0.3",
    "supertest": "^7.0.0"
  }
}
