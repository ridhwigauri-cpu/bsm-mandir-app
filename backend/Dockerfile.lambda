# Lambda **container image** — इसी में Chromium है, इसलिए रसीद PDF भी सर्वर पर बनती है।
# (सामान्य zip deploy में PDF ऐप में बनती है; यह विकल्प तब चुनें जब PDF सर्वर से चाहिए)
FROM public.ecr.aws/lambda/nodejs:20

RUN dnf install -y chromium nss mesa-libgbm atk cups-libs pango libdrm alsa-lib || true

ENV CHROMIUM_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_DOWNLOAD=1
ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev || npm install --omit=dev

COPY src ./src
COPY assets ./assets
COPY db ./db

CMD ["src/lambda.handler"]
